APP_ENV=production
APP_SECRET=请替换为至少32位随机串
# 数据库（MySQL 示例；也可用 sqlite）
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
PUBLIC_URL=https://你的域名
ADMIN_EMAIL=
ADMIN_PASSWORD=
CAPTCHA_DEV_ECHO=false
MAIL_DEV_FALLBACK=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=AI 对话站
# 单文件上限（同时受 PHP post_max_size / nginx client_max_body_size 限制）
MAX_FILE_MB=12

# 角色卡市场（可选，多个 Key 逗号分隔，每个每天 500 次）
MARKET_API_KEYS=
