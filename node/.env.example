# 服务端
PORT=8787
NODE_ENV=development
APP_ORIGIN=http://localhost:8787

# 必填：随机 32 字节 hex，用于加密数据库中的第三方 API Key
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

SESSION_DAYS=7

# 超级管理员种子账号
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# QQ 邮箱 SMTP（SMTP_PASS 填 16 位「授权码」，不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 发件地址必须与 SMTP_USER 一致，QQ 会校验
SMTP_FROM=
# 收件人看到的发件人名称
SMTP_FROM_NAME=AI 对话站

# 未配置 SMTP 时把验证码回显到接口，仅限本地调试，生产必须 false
MAIL_DEV_FALLBACK=true

# 图形验证码答案回显（本地联调用），生产必须 false
CAPTCHA_DEV_ECHO=true

# 对外访问地址，用于额度告警邮件里的「关闭接口」链接；生产必须改成正式域名
PUBLIC_URL=http://localhost:8787

UPLOAD_DIR=./data/uploads
MAX_FILE_MB=30

# 角色卡市场（可选，多个 Key 逗号分隔，每个每天 500 次）
MARKET_API_KEYS=
